# ── GitHub credentials ────────────────────────────────────────────────────────
# Option A — GitHub App (recommended): short-lived installation tokens, no manual rotation.
# Leave GITHUB_TOKEN unset and supply the three vars below.
# Required App permissions: Organization → Self-hosted runners (Read & write),
#                           Organization → Members (Read).
# Note: App installation tokens cannot access GHCR regardless of Packages permission.
#       Runner/controller/deployer images must be public when using this auth path.
#GITHUB_APP_ID=123456
#GITHUB_APP_INSTALLATION_ID=78901234
#GITHUB_APP_PRIVATE_KEY_PATH=/run/secrets/github_app_key   # path INSIDE the controller
#GITHUB_APP_PRIVATE_KEY_HOST_PATH=/home/ghrunner/.ssh/github-app.pem   # host path (default shown)

# Option B — Static PAT (backward compat): set both vars and leave the App vars above unset.
# Classic token required (fine-grained PATs do not support manage_runners:org).
# Scopes: admin:org, manage_runners:org, read:packages
#GITHUB_TOKEN=ghp_...
#GHCR_USERNAME=your-github-username   # GitHub account that owns this PAT

GITHUB_ORG=your-org
GITHUB_REPO=infra-runner    # repo name; used by the deployer to build the cosign
                             # certificate identity for signature verification

# ── Runner pool ───────────────────────────────────────────────────────────────
RUNNER_LABELS=self-hosted,linux,x64
DESIRED_IDLE=2              # idle runners to keep ready (busy runners are not counted)
MAX_RUNNERS=2               # hard cap on runner containers, idle + busy (default: DESIRED_IDLE)
RUNNER_MEMORY=6g            # memory limit per runner container; leaves 2.5g beyond max tmpfs usage
RUNNER_CPUS=2               # CPU limit per runner container
RUNNER_PIDS_LIMIT=4096      # max processes per runner container (fork-bomb guard)
#RUNNER_SUBNET_PREFIX=10.89     # job networks: explicit /24s from <prefix>.0.0/16 (egress-restricted range)
#RUNNER_GROUP_ID=1          # runner group for JIT registration (1 = Default)
#RUNNER_REGISTRATION_MODE=jit   # jit (single-use, default) | token (legacy, reusable for 1 h)
#SHUTDOWN_CLEANUP=idle      # on controller stop: idle (keep busy runners) | all | none
RUNNER_KANIKO_SIZE=2g       # tmpfs size for Kaniko scratch space (/kaniko inside runner)
                             # increase if your images have large base layers
#RUNNER_RUNTIME=kata         # opt in after scripts/setup-kata.sh and check-kata-runner.sh pass
#RUNNER_KATA_DNS=1.1.1.1    # public IPv4 resolver inside Kata guest on isolated runner bridges

# ── Runner security hardening ─────────────────────────────────────────────────
# AppArmor: load the profile with scripts/setup-apparmor.sh before first start.
# Set empty to disable (not recommended).
RUNNER_APPARMOR_PROFILE=infra-runner   # explicitly empty (RUNNER_APPARMOR_PROFILE=) disables it

# Seccomp: path to seccomp/runner-profile.json INSIDE the controller container. The docker
# CLI reads the file and sends its contents to the daemon; docker-compose.yml mounts the
# repo's profile at the path below.
# REQUIRED for Buildah image builds: Docker's built-in default seccomp profile
# blocks clone(CLONE_NEWUSER), which Buildah needs for container setup. The
# custom profile is default-ALLOW with a small deny-list (kexec_load, init_module,
# bpf, …) — it is more permissive than Docker's default. See README → Threat model.
# Typical value: /home/ghrunner/infra-runner/seccomp/runner-profile.json
RUNNER_SECCOMP_HOST_PATH=/home/ghrunner/infra-runner/seccomp/runner-profile.json

# ── GitOps deployer ───────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=infra-runner  # compose project name; changing it on a running stack orphans its containers/networks
POLL_INTERVAL=60                  # seconds between GHCR digest checks
HEALTH_PORT=8080                  # GET /health endpoint; poll with UptimeRobot, Grafana, etc.
#HEALTH_BIND=127.0.0.1            # publish /health on localhost only (default 0.0.0.0)
CONTROLLER_POLL_INTERVAL=15       # seconds between controller pool maintenance cycles
#SELF_UPDATE_TIMEOUT=120          # max seconds to wait for the deployer self-update helper
#HEALTH_MAX_AGE=                  # /health → 503 "stale" after this many seconds without a cycle
                                  # (default: 3*POLL_INTERVAL + SELF_UPDATE_TIMEOUT + PLUGIN_HOOK_TIMEOUT)

# Absolute path to this repo on the HOST filesystem.
# REQUIRED for deployer self-updates to work correctly: when the deployer runs
# docker compose from inside a container (--project-directory /workspace), relative
# volume paths like "./" resolve to the container path, not the host path. Setting
# COMPOSE_PROJECT_DIR to the absolute host path ensures the new deployer container
# gets the correct workspace bind mount across self-update generations.
COMPOSE_PROJECT_DIR=/home/ghrunner/infra-runner

# ── Plugin system (optional) ──────────────────────────────────────────────────
# External projects self-register by shipping a *.plugin descriptor and a
# docker-compose.infra-runner.yml overlay that mounts it into /plugins/.
# See deployer/PLUGINS.md for the descriptor format and a worked example.
#
# Activate a plugin overlay by appending it to COMPOSE_FILE:
#COMPOSE_FILE=docker-compose.yml:../infra-vault/docker-compose.infra-runner.yml
#
#PLUGINS_DIR=/plugins/   # default — override only if using a custom overlay mount point
#PLUGIN_HOOK_TIMEOUT=300   # default timeout for plugin post-deploy hooks (seconds)
#PLUGIN_HOOK_ENV=          # env var names passed to ALL plugin hooks; hooks never get GITHUB_TOKEN/GITHUB_APP_*

# ── Vault plugin env vars (required when vault-unseal plugin is active) ───────
# VAULT_CERT_IDENTITY and image ref live in infra-vault's .infra-runner.plugin descriptor.
#VAULT_COMPOSE_DIR=/home/ghrunner/infra-vault
#VAULT_TOKEN=hvs.XXXX   # Vault operator token — stays on server, never in GitHub
#VAULT_ADDR=http://vault:8200
#VAULT_NET=vault-net

# ── Edge plugin (infra-edge: nginx edge gateway) ──────────────────────────────
# Image ref and cert identity live in infra-edge's .infra-runner.plugin descriptor.
# Also append ../infra-edge/docker-compose.infra-runner.yml to COMPOSE_FILE above.
#EDGE_COMPOSE_DIR=/home/ghrunner/infra-edge
